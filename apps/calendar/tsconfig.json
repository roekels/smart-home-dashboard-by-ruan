{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023"], "types": ["@cloudflare/workers-types"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "noUnusedLocals": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true
  },
  "include": ["src", "../../packages/core/src"]
}
