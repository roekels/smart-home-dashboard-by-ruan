{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The MCP gateway Worker: one OAuth server and one MCP address per module, on the dashboard's own domain.",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
