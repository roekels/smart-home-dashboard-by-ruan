{
  "module": "alfred",
  "workers": [
    {
      "app": "alfred",
      "compatibilityFlags": ["nodejs_compat"],
      "durableObjects": [
        { "binding": "CONVERSATIONS", "className": "Conversation" },
        { "binding": "REGISTRY", "className": "Registry" }
      ],
      "services": [{ "binding": "GATEWAY", "app": "gateway" }],
      "vars": {
        "ALFRED_MODEL": "claude-opus-5-5",
        "ALFRED_EFFORT": "low",
        "ALFRED_DAILY_TOKEN_LIMIT": "2000000",
        "ALFRED_TOOL_POLICY": "{}"
      }
    }
  ],
  "shell": { "services": [{ "binding": "ALFRED", "app": "alfred" }] },
  "secrets": [
    { "name": "ALFRED_ANTHROPIC_API_KEY", "app": "alfred" },
    { "name": "ALFRED_GATEWAY_KEY", "app": "alfred" }
  ],
  "gatewayKeys": [
    {
      "name": "alfred",
      "scopes": ["household.read", "home.read", "home.control", "home.lists", "finance.read", "finance.write", "health.read", "health.write"],
      "secret": "ALFRED_GATEWAY_KEY",
      "app": "alfred"
    }
  ],
  "checks": []
}
